<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "Missions" %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="app-shell">
      <aside class="side-nav">
        <div class="brand">SEO Mission Control</div>
        <a href="/dashboard">Dashboard</a>
        <a class="active" href="/todos">Missions</a>
        <a href="/keywords">Keywords</a>
        <a href="/audit">Audits</a>
      </aside>

      <section class="app-main">
        <header class="app-header">
          <div>
            <p class="eyebrow">Action tracking</p>
            <h1>Missions</h1>
            <p>Plan, track and complete SEO, GEO and AEO improvements with clear impact and effort.</p>
          </div>
          <a class="button-link" href="/audit">Run audit</a>
        </header>

        <section class="summary-strip mission-strip">
          <article class="metric-card"><span>Total</span><strong><%= todoSummary?.total || 0 %></strong><small>All missions</small></article>
          <article class="metric-card"><span>Active</span><strong><%= todoSummary?.active || 0 %></strong><small>Need work</small></article>
          <article class="metric-card"><span>Planned</span><strong><%= todoSummary?.planned || 0 %></strong><small>Scheduled</small></article>
          <article class="metric-card"><span>Done</span><strong><%= todoSummary?.done || 0 %></strong><small>Completed</small></article>
        </section>

        <% if (todos && todos.length) { %>
          <section class="todo-board mission-board">
            <% todos.forEach(function(todo) { %>
              <article class="todo-card mission-card priority-<%= todo.priority || todo.severity || "medium" %>">
                <div>
                  <span class="status-pill"><%= todo.status %></span>
                  <h3><%= todo.checkName || todo.category || "SEO mission" %></h3>
                  <p><%= todo.recommendation || todo.message %></p>
                  <div class="explanation-grid compact-explanation">
                    <div>
                      <strong>Why it matters</strong>
                      <p><%= todo.why || todo.businessImpact || "This mission improves search clarity, user confidence or competitive visibility." %></p>
                    </div>
                    <div>
                      <strong>How to fix</strong>
                      <p><%= todo.how || todo.implementationHint || "Update the affected page, then rerun the audit to confirm the signal improved." %></p>
                    </div>
                    <div>
                      <strong>Expected impact</strong>
                      <p><%= todo.expectedImpact || "Higher score, clearer page understanding and better prioritisation." %></p>
                    </div>
                  </div>
                  <% if (todo.effort) { %><small>Effort: <%= todo.effort %></small><% } %>
                  <small><%= todo.pageUrl %></small>
                </div>

                <form method="POST" action="/todos/<%= todo._id %>/status">
                  <label>Status</label>
                  <select name="status">
                    <% ["new", "planned", "in_progress", "blocked", "done", "ignored"].forEach(function(status) { %>
                      <option value="<%= status %>" <%= todo.status === status ? "selected" : "" %>><%= status %></option>
                    <% }) %>
                  </select>
                  <label>Due date</label>
                  <input type="date" name="dueDate" value="<%= todo.dueDate ? new Date(todo.dueDate).toISOString().slice(0, 10) : "" %>" />
                  <button type="submit">Update mission</button>
                </form>
              </article>
            <% }) %>
          </section>
        <% } else { %>
          <section class="card">
            <p>No missions yet. Run an audit and add recommendations into your mission board.</p>
          </section>
        <% } %>
      </section>
    </main>
  </body>
</html>
